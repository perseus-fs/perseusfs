{
  "name": "@perseusfs/server",
  "module": "app.ts",
  "type": "module",
  "version": "0.0.4",
  "scripts": {
    "dev": "bun --bun run --watch ./src/app.ts",
    "format": "prettier --write \"**/*.ts*\" --config ./.prettierrc.json",
    "lint": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives",
    "lint:fix": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "magic": "bun --bun run lint:fix && bun --bun run format && bun --bun run check-types"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.8",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "eslint": "^8.56.0",
    "eslint-plugin-unused-imports": "^4.1.4"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@perseusfs/shared": "workspace:*",
    "chalk": "^5.4.1",
    "croner": "^9.0.0",
    "file-type-mime": "^0.4.6",
    "jsonwebtoken": "^9.0.2",
    "sanitize-filename": "^1.6.3",
    "zod": "^3.24.2"
  }
}